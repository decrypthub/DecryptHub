{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DecryptHub",
  "version": "1.4.0",
  "identifier": "com.webdecrypthub.app",
  "build": {
    "frontendDist": "../ui-dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {},
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "windows/installer.ico",
        "uninstallerIcon": "windows/installer.ico",
        "headerImage": "windows/header.bmp",
        "uninstallerHeaderImage": "windows/header.bmp",
        "sidebarImage": "windows/sidebar.bmp",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExMTlBQzk3MzYyRTdEMjIKUldRaWZTNDJsNndab1VNWTBZcmVGSVdXSTRRL2V3TitkTFBLdkVTdVZ3UTI5R1E3d2RCZnBpZE4K",
      "endpoints": [
        "https://github.com/decrypthub/DecryptHub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "DecryptHub"
}
